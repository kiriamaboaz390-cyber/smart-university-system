generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums replaced with string fields for SQLite local development.
// Allowed values are documented in `docs/LIVING_DOC.md` and validated at the application layer.

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String
  lastName    String
  role        String   @default("STUDENT")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  attendance  AttendanceRecord[]
  auditLogs   AuditLog[]
  lecturer    LecturerProfile?
  student     StudentProfile?
  authCredential AuthCredential?
}

model AuthCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model LecturerProfile {
  id          String @id @default(cuid())
  userId      String @unique
  title       String?
  department  String?
  user        User   @relation(fields: [userId], references: [id])
  sessions    Session[]
}

model StudentProfile {
  id          String @id @default(cuid())
  userId      String @unique
  studentCode String @unique
  yearLevel   Int
  programme   String
  user        User   @relation(fields: [userId], references: [id])
}

model Campus {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  buildings Building[]
  createdAt DateTime  @default(now())
}

model Building {
  id        String  @id @default(cuid())
  campusId  String
  name      String
  code      String  @unique
  campus    Campus  @relation(fields: [campusId], references: [id])
  rooms     Room[]
}

model Room {
  id        String   @id @default(cuid())
  buildingId String
  name      String
  code      String   @unique
  capacity  Int
  status    String   @default("AVAILABLE")
  equipment String?  // comma-separated labels like "projector,lab-bench"
  building  Building @relation(fields: [buildingId], references: [id])
  sessions  Session[]
}

model StudentGroup {
  id        String @id @default(cuid())
  programme String
  year      Int
  name      String
  createdAt DateTime @default(now())
}

model TermConfig {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  examStart DateTime?
  examEnd   DateTime?
  campusId  String?
  createdAt DateTime @default(now())
}

model Course {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  credits     Int
  department  String
  sessions    Session[]
  examSlots   ExamSchedule[]
}

model Session {
  id          String          @id @default(cuid())
  courseId    String
  lecturerId  String
  roomId      String
  day         String
  startTime   Int
  endTime     Int
  type        String          @default("LECTURE")
  createdAt   DateTime        @default(now())
  course      Course          @relation(fields: [courseId], references: [id])
  lecturer    LecturerProfile @relation(fields: [lecturerId], references: [id])
  room        Room            @relation(fields: [roomId], references: [id])
  attendance  AttendanceRecord[]
  user        User?           @relation(fields: [userId], references: [id])
  userId      String?
}

model AttendanceRecord {
  id          String            @id @default(cuid())
  sessionId   String
  studentId   String
  status      String            @default("PRESENT")
  scannedAt   DateTime?
  createdAt   DateTime          @default(now())
  session     Session           @relation(fields: [sessionId], references: [id])
  student     User              @relation(fields: [studentId], references: [id])
}

model ExamSchedule {
  id          String   @id @default(cuid())
  courseId    String
  roomId      String?
  examDate    DateTime
  startTime   Int
  endTime     Int
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String
  entityType  String
  entityId    String
  details     String?
  createdAt   DateTime @default(now())
}

model StudentGroupMembership {
  id          String   @id @default(cuid())
  studentId   String   @unique
  groupId     String
  createdAt   DateTime @default(now())
  student     User     @relation(fields: [studentId], references: [id])
}

model ChangeRequest {
  id            String   @id @default(cuid())
  sessionId     String
  lecturerId    String
  requestedBy   String
  currentRoomId String?
  newRoomId     String?
  currentDay    String?
  newDay        String?
  currentStart  Int?
  newStart      Int?
  currentEnd    Int?
  newEnd        Int?
  reason        String?
  status        String   @default("PENDING") // PENDING, AUTO_APPROVED, APPROVED, REJECTED, TIMEOUT
  approvedBy    String?
  approvalReason String?
  approvalAt    DateTime?
  createdAt     DateTime @default(now())
  expiresAt     DateTime // 48 hour timeout for SuperAdmin overrides
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // SESSION_START, CHANGE_REQUEST, APPROVAL, OVERRIDE_GRANTED
  title     String
  message   String
  relatedId String?  // session, change request, etc.
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
